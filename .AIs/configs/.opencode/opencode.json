{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/AGENTS.md",
    ".agents/docs/README.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "git *": "allow",
      "npm run test*": "allow",
      "pytest *": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npx *": "allow",
      "docker *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "~/.env": "deny",
      "**/.env": "deny",
      "*": "allow"
    }
  }
}