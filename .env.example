# .env.example — Variáveis de ambiente do VERS
#
# Copie este arquivo como .env e preencha os valores.
# ATENÇÃO: .env NÃO deve ser versionado (já está no .gitignore).

# ──────────────────────────────────────────────
# Redis (local)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Banco de dados (Neon — dev e produção)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-seu-projeto.us-east-2.aws.neon.tech/vers?sslmode=require

# ──────────────────────────────────────────────
# Backend (NestJS)
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRATION=7d

# ──────────────────────────────────────────────
# Web (Vite)
# ──────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ──────────────────────────────────────────────
# Dashboard (Vite + Electron)
# ──────────────────────────────────────────────
VITE_DASHBOARD_API_URL=http://localhost:3000
VITE_DASHBOARD_WS_URL=ws://localhost:3000

# ──────────────────────────────────────────────
# Mobile (Expo)
# ──────────────────────────────────────────────
EXPO_HOST=localhost
EXPO_API_URL=http://localhost:3000
EXPO_WS_URL=ws://localhost:3000

# ──────────────────────────────────────────────
# AI Service (FastAPI)
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
AI_DATABASE_URL=${DATABASE_URL}
