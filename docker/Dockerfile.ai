# Dockerfile.ai — Build e execução do AI Service (FastAPI)
#
# Serviço Python que faz análise de dados com OpenAI.
# Usa aiosqlite como fallback e SQLAlchemy async para PostgreSQL.

FROM python:3.14-slim
WORKDIR /app

# Instala dependências do sistema necessárias para psycopg2 caso um dia volte
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Copia e instala dependências Python
COPY services/ai-service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código do serviço
COPY services/ai-service/src/ ./src/

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
