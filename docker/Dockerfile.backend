# Dockerfile.backend — Build e execução do backend NestJS
#
# Usa pnpm como gerenciador de pacotes. Multi-stage: primeiro instala
# dependências e compila, depois gera a imagem final menor.

# ---- Stage 1: Instalação e build ----
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copia os manifests do root e do backend.
# O schema do Prisma vem antes do install porque o postinstall do backend
# roda `prisma generate` e precisa dele já presente.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY services/backend/package.json ./services/backend/
COPY services/backend/prisma ./services/backend/prisma
COPY services/backend/prisma.config.ts ./services/backend/
COPY packages/ ./packages/

# DATABASE_URL dummy só para o `prisma generate` do postinstall/build.
# Em runtime o valor real vem do .env (env_file no compose).
ENV DATABASE_URL=postgresql://build:build@localhost:5432/vers

# Instala dependências (apenas as de produção + dev para build)
RUN pnpm install --frozen-lockfile

# Copia o código-fonte do backend
COPY services/backend/ ./services/backend/

# Gera o Prisma Client e compila
RUN cd services/backend && \
    npx prisma generate && \
    pnpm build

# ---- Stage 2: Imagem final ----
FROM node:22-alpine
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copia os artifacts do build mantendo o layout do workspace pnpm:
# o dist fica dentro de services/backend para que o Node resolva as
# dependências em services/backend/node_modules e /app/node_modules.
COPY --from=builder /app/services/backend/dist ./services/backend/dist
COPY --from=builder /app/services/backend/package.json ./services/backend/package.json
COPY --from=builder /app/services/backend/node_modules ./services/backend/node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/package.json ./

EXPOSE 3000

CMD ["node", "services/backend/dist/main"]
