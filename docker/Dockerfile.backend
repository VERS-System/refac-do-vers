# Compila o backend e preserva o layout e os links pnpm no runtime.
FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS builder
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@11.21.0
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ ./packages/
COPY services/backend/ ./services/backend/
# URL sintetica apenas para gerar Prisma Client; nenhuma conexao de banco no build.
RUN DATABASE_URL=postgresql://user:password@localhost:5432/vers_test pnpm --filter @vers/backend install --frozen-lockfile
RUN pnpm --filter @vers/backend build

FROM base AS runtime
COPY --from=builder /app /app
WORKDIR /app/services/backend
EXPOSE 3000
CMD ["node", "dist/services/backend/src/main.js"]
