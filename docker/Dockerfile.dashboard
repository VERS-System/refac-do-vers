# Dockerfile.dashboard — Dev server do Dashboard Vite + Electron
#
# Roda o Vite dev server para o renderizador do Electron.
# O Electron propriamente dito roda nativo na máquina host e
# consome este servidor.

FROM node:22-alpine
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copia os manifests
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY services/dashboard/package.json ./services/dashboard/
COPY packages/ ./packages/

# Instala dependências
RUN pnpm install --frozen-lockfile

# Copia o código-fonte
COPY services/dashboard/ ./services/dashboard/
COPY packages/ ./packages/

EXPOSE 5174

CMD ["pnpm", "--filter", "@vers/dashboard", "dev", "--host", "0.0.0.0"]
