# .env.example — AI Service (FastAPI + OpenAI)
#
# Copie como .env para rodar o AI service independente.
# Por padrão usa SQLite local para dev sem depender de rede.
# Neon (produção): descomente a linha abaixo e ajuste as credenciais.

DATABASE_URL=sqlite+aiosqlite:///./vers.db
# DATABASE_URL=postgresql+asyncpg://user:password@ep-seu-projeto.us-east-2.aws.neon.tech/vers?sslmode=require

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
