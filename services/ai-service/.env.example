# .env.example — AI Service (FastAPI + OpenAI)
#
# Copie como .env para rodar o AI service independente.

DATABASE_URL=sqlite+aiosqlite:///./vers.db
# Para PostgreSQL (ex: Neon), use:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vers

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
