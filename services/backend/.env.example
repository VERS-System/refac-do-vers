# .env.example — Backend NestJS
#
# Copie como .env para rodar o backend independente.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3050,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:8080

DATABASE_URL=postgresql://user:password@ep-seu-projeto.us-east-2.aws.neon.tech/vers?sslmode=require

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-to-a-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# true inicia coordenador Redis/Socket.IO e ingestão após HTTP pronto; false mantém REST passivo.
# Habilitar somente com broker TLS e banco autorizados; nunca usar credenciais do dispositivo.
# Credencial consumidora separada das credenciais individuais dos dispositivos.
MQTT_ENABLED=false
# MQTT_URL=mqtts://broker.example.test:8883
# MQTT_USERNAME=backend-reader
# MQTT_PASSWORD=configure-with-a-secret-outside-version-control
# MQTT_CLIENT_ID=vers-backend-local

# Viber (assistente): desabilitada por padrão; sem efeito no boot do núcleo.
# Ao habilitar, VIBER_AI_URL e VIBER_INTERNAL_TOKEN são obrigatórias:
# o token deve ser idêntico ao VIBER_INTERNAL_TOKEN do ai-service.
VIBER_ENABLED=false
# VIBER_AI_URL=http://ai-service:8000
# VIBER_INTERNAL_TOKEN=configure-with-a-random-internal-token-of-16-chars
