// Prisma schema do VERS
//
// Define as entidades do sistema: testes, configurações, telemetria,
// mensagens MQTT, interações com IA e previsões.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define os estados permitidos para uma conta do VERS.
enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION

  @@map("user_status")
}

// Define os papéis globais que podem coexistir em uma conta.
enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

// Define o tipo de vínculo de uma conta com um veículo.
enum VehicleRelationship {
  OWNER
  DRIVER
  ADMIN

  @@map("vehicle_relationship")
}

// Define os estados públicos da instalação física VERS.
enum InstallationStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  FAULT

  @@map("installation_status")
}

// Define os estados públicos de um ESP32 associado a uma instalação.
enum DeviceStatus {
  PROVISIONING
  ONLINE
  OFFLINE
  REVOKED
  FAULT

  @@map("device_status")
}

// Descreve a ligação elétrica dos piezoelétricos no snapshot da montagem.
enum PiezoAssociation {
  SERIES
  PARALLEL
  MIXED

  @@map("piezo_association")
}

// Descreve o armazenamento de energia usado pela montagem.
enum StorageType {
  BATTERY
  SUPERCAPACITOR
  CAPACITOR
  NONE

  @@map("storage_type")
}

// Guarda a identidade local sem persistir senha ou token em texto puro.
model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.Citext
  passwordHash    String           @map("password_hash")
  displayName     String?          @map("display_name")
  avatarUrl       String?          @map("avatar_url")
  status          UserStatus       @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?        @map("email_verified_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  roles           UserRoleAssignment[]
  refreshSessions RefreshSession[]
  vehicles        UserVehicle[]

  @@map("users")
}

// Associa papéis globais distintos ao mesmo usuário sem tabela de catálogo.
model UserRoleAssignment {
  userId    String   @map("user_id") @db.Uuid
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_role_assignments")
}

// Persiste somente hashes de refresh tokens e o histórico de revogação.
model RefreshSession {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  tokenHash           String           @unique @map("token_hash")
  deviceLabel         String?          @map("device_label")
  expiresAt           DateTime         @map("expires_at")
  revokedAt           DateTime?        @map("revoked_at")
  replacedBySessionId String?          @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          RefreshSession?  @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            RefreshSession[] @relation("SessionReplacement")

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// Guarda a identificação atual do veículo enquanto houver contas vinculadas.
model Vehicle {
  id           String        @id @default(uuid()) @db.Uuid
  licensePlate String        @unique @map("license_plate") @db.Citext
  brand        String?
  model        String?
  modelYear    Int?          @map("model_year")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  users        UserVehicle[]
  installations VersInstallation[]

  @@map("vehicles")
}

// Associa contas e veículos sem transferir a propriedade do registro físico.
model UserVehicle {
  userId       String              @map("user_id") @db.Uuid
  vehicleId    String              @map("vehicle_id") @db.Uuid
  relationship VehicleRelationship
  isPrimary    Boolean             @default(false) @map("is_primary")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle      Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@id([userId, vehicleId])
  @@index([vehicleId])
  @@map("user_vehicles")
}

// Liga uma montagem VERS ao veículo até a exclusão física deste registro.
model VersInstallation {
  id             String             @id @default(uuid()) @db.Uuid
  vehicleId      String             @map("vehicle_id") @db.Uuid
  systemModel    String             @map("system_model")
  serialNumber   String?            @unique @map("serial_number")
  status         InstallationStatus @default(INACTIVE)
  installedAt    DateTime?          @map("installed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  devices        Device[]
  configurations Configuration[]

  @@unique([id, vehicleId])
  @@index([vehicleId, status])
  @@map("vers_installations")
}

// Identifica o ESP32 sem persistir credenciais MQTT em texto puro.
model Device {
  id              String           @id @default(uuid()) @db.Uuid
  installationId  String           @map("installation_id") @db.Uuid
  vehicleId       String           @map("vehicle_id") @db.Uuid
  deviceUid       String           @unique @map("device_uid")
  name            String?
  firmwareVersion String?          @map("firmware_version")
  status          DeviceStatus     @default(PROVISIONING)
  lastSeenAt      DateTime?        @map("last_seen_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  installation    VersInstallation @relation(fields: [installationId, vehicleId], references: [id, vehicleId], onDelete: Cascade)

  @@index([installationId, vehicleId])
  @@map("devices")
}

// ────────────────────────────────────────────
// Configuration — versão imutável da montagem usada nos testes
// ────────────────────────────────────────────
model Configuration {
  id                String           @id @default(uuid()) @db.Uuid
  installationId    String           @map("installation_id") @db.Uuid
  name              String
  version           Int
  activePiezoCount  Int              @map("active_piezo_count")
  piezoAssociation  PiezoAssociation @map("piezo_association")
  installationPoint String           @map("installation_point")
  storageType       StorageType      @map("storage_type")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  installation      VersInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  tests             Test[]

  @@unique([installationId, version])
  @@map("configurations")
}

// ────────────────────────────────────────────
// Test — execução experimental
// ────────────────────────────────────────────
model Test {
  id               String    @id @default(uuid())
  name             String
  configurationId  String    @map("configuration_id") @db.Uuid
  satisfatory      Boolean   @default(false)
  terrain          String    // highway | city | offroad | mixed | other
  rpm              Float?
  watts            Float?
  amp              Float?
  current          Float?
  batteryUsed      Float?    @map("battery_used")
  batteryGenerated Float?    @map("battery_generated")
  numPiezos        Int       @map("num_piezos")
  startTime        DateTime? @map("start_time")
  endTime          DateTime? @map("end_time")
  duration         Int?      // segundos
  weight           Float?
  avgSpeed         Float?    @map("avg_speed")
  incline          Float?
  notes            String?
  status           String    @default("planned") // planned | running | completed | failed
  createdAt        DateTime  @default(now()) @map("created_at")

  configuration Configuration @relation(fields: [configurationId], references: [id])
  telemetry     Telemetry[]
  predictions   AiPrediction[]

  @@map("tests")
}

// ────────────────────────────────────────────
// Telemetry — leituras individuais dos sensores
// ────────────────────────────────────────────
model Telemetry {
  id                String   @id @default(uuid())
  testId            String   @map("test_id")
  timestamp         DateTime
  voltage           Float?
  current           Float?
  power             Float?
  energyAccumulated Float?   @map("energy_accumulated")
  accelerationX     Float?   @map("acceleration_x")
  accelerationY     Float?   @map("acceleration_y")
  accelerationZ     Float?   @map("acceleration_z")
  temperature       Float?
  sensorStatus      String?  @map("sensor_status")
  quality           String?
  createdAt         DateTime @default(now()) @map("created_at")

  test Test @relation(fields: [testId], references: [id])

  @@map("telemetries")
}

// ────────────────────────────────────────────
// EnergySummary — resumos diários/mensais para dashboard
// ────────────────────────────────────────────
model EnergySummary {
  id              String   @id @default(uuid())
  date            DateTime
  period          String   // daily | monthly
  batteryRecovered Float?  @map("battery_recovered")
  batteryUsed     Float?   @map("battery_used")
  energyPerHour   Json?    @map("energy_per_hour")
  moneyEconomy    Float?   @map("money_economy")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("energy_summaries")
}

// ────────────────────────────────────────────
// MqttMessage — dados brutos recebidos via MQTT
// ────────────────────────────────────────────
model MqttMessage {
  id        String   @id @default(uuid())
  topic     String
  payload   Json
  timestamp DateTime
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mqtt_messages")
}

// ────────────────────────────────────────────
// AiInteraction — histórico do chat Viber
// ────────────────────────────────────────────
model AiInteraction {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  question  String
  answer    String
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_interactions")
}

// ────────────────────────────────────────────
// AiPrediction — previsões geradas pela IA
// ────────────────────────────────────────────
model AiPrediction {
  id              String   @id @default(uuid())
  testId          String   @map("test_id")
  predictionType  String   @map("prediction_type") // anomaly | trend | forecast
  predictionData  Json     @map("prediction_data")
  createdAt       DateTime @default(now()) @map("created_at")

  test Test @relation(fields: [testId], references: [id])

  @@map("ai_predictions")
}
